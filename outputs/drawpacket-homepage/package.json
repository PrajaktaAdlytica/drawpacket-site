{
  "name": "drawpacket-homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node scripts/prerender.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/demo.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs",
    "video:studio": "remotion studio video/index.jsx --no-open --port=4180",
    "video:desktop": "remotion render video/index.jsx ReviewAperture public/media/drawpacket-intro-desktop.mp4 --codec=h264 --crf=20 --concurrency=1 --chrome-mode=chrome-for-testing",
    "video:mobile": "remotion render video/index.jsx ReviewApertureMobile public/media/drawpacket-intro-mobile.mp4 --codec=h264 --crf=20 --concurrency=1 --chrome-mode=chrome-for-testing"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "remotion": "4.0.534"
  }
}
